APP_NAME="Barber CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
TRUSTED_PROXIES=
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=barber_crm
DB_USERNAME=barber_crm
DB_PASSWORD=
PHONE_NUMBER_DEFAULT_REGION=NG

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=
WHATSAPP_WEBHOOK_MAX_BYTES=1048576
WHATSAPP_WEBHOOK_PAYLOAD_RETENTION_DAYS=30
WHATSAPP_WEBHOOK_CALLBACK_STALE_MINUTES=10
AUTOMATIONS_ENABLED=false
AUTOMATION_MAX_ATTEMPTS=5
AUTOMATION_MANUAL_RETRY_LIMIT=2
AUTOMATION_STALLED_AFTER_MINUTES=10
AUTOMATION_QUEUED_RECOVERY_AFTER_MINUTES=5
AUTOMATION_MINIMUM_CUSTOMER_MESSAGE_INTERVAL_HOURS=72

SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=${APP_ENV}
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.0

MAIL_MAILER=log
MAIL_SCHEME=tls
MAIL_HOST=smtp.postmarkapp.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="crm@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
