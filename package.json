{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.24.0",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint resources/js",
        "types:check": "tsc --noEmit",
        "test:e2e": "playwright test",
        "format": "prettier --write \"resources/js/**/*.{ts,tsx,css}\" \"resources/css/**/*.css\"",
        "format:check": "prettier --check \"resources/js/**/*.{ts,tsx,css}\" \"resources/css/**/*.css\""
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@inertiajs/vite": "^3.11.0",
        "@playwright/test": "^1.65.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "24.10.2",
        "@types/react": "19.2.12",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "concurrently": "^10.0.3",
        "eslint": "^10.15.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "laravel-vite-plugin": "^3.1",
        "prettier": "3.10.1",
        "tailwindcss": "^4.0.0",
        "typescript": "6.0.2",
        "typescript-eslint": "^8.74.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/react": "^3.11.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "1.79.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.1"
    }
}
